{
  "manifest_version": 3,
  "name": "My Day Web Clipper",
  "version": "1.0.0",
  "description": "Clip the page you are reading into your My Day workspace (Joplin) as a note in Web Clippings.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": [
    "https://eduvora.shop/*",
    "https://digitalcatalyst.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Clip to My Day",
    "default_popup": "popup.html"
  },
  "commands": {
    "clip-page": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Clip the current page to My Day"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "myday-clipper@digitalcatalyst",
      "strict_min_version": "121.0"
    }
  }
}
