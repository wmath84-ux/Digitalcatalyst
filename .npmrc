# @capacitor-firebase/authentication@7.x declares `firebase@^11` as an optional
# peer, but the app ships firebase@12 and the plugin's JS surface is compatible
# (it only exchanges an ID token; see docs/android-google-signin.md). The
# `overrides` block in package.json pins the peer to the app's own firebase
# version, and this flag stops a bare `npm install` from failing on the
# now-satisfied-but-still-declared range.
legacy-peer-deps=true
