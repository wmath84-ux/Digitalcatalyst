# @capacitor-firebase/authentication@7.x declares `firebase@^11` as an OPTIONAL
# peer, but the app ships firebase@12. The plugin only exchanges an ID token
# (see docs/android-google-signin.md), so the mismatch is cosmetic — but npm
# still treats an unmet peer as a hard error, which would break a plain
# `npm install` and the `npm ci` in .github/workflows/android-build.yml.
#
# Only npm needs this. pnpm (which Vercel uses) merely warns about unmet
# optional peers, so there is deliberately NO matching `pnpm.overrides` entry:
# adding one changes the `overrides` map recorded in pnpm-lock.yaml, and
# Vercel's frozen install then fails with ERR_PNPM_LOCKFILE_CONFIG_MISMATCH.
legacy-peer-deps=true
