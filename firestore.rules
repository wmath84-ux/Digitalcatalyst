rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Rules are NOT JavaScript: list.all / arrow functions cannot compile.
    // Guard each bounded index so empty/short lists never access a missing item.
    function validNoteLinkAt(links, index) {
      return links.size() <= index || (links[index] is string && links[index].size() <= 80);
    }
    function validNoteLinks(links) {
      return links is list && links.size() <= 50
        && (
        validNoteLinkAt(links, 0)
        && validNoteLinkAt(links, 1)
        && validNoteLinkAt(links, 2)
        && validNoteLinkAt(links, 3)
        && validNoteLinkAt(links, 4)
        && validNoteLinkAt(links, 5)
        && validNoteLinkAt(links, 6)
        && validNoteLinkAt(links, 7)
        && validNoteLinkAt(links, 8)
        && validNoteLinkAt(links, 9)
        && validNoteLinkAt(links, 10)
        && validNoteLinkAt(links, 11)
        && validNoteLinkAt(links, 12)
        && validNoteLinkAt(links, 13)
        && validNoteLinkAt(links, 14)
        && validNoteLinkAt(links, 15)
        && validNoteLinkAt(links, 16)
        && validNoteLinkAt(links, 17)
        && validNoteLinkAt(links, 18)
        && validNoteLinkAt(links, 19)
        && validNoteLinkAt(links, 20)
        && validNoteLinkAt(links, 21)
        && validNoteLinkAt(links, 22)
        && validNoteLinkAt(links, 23)
        && validNoteLinkAt(links, 24)
        && validNoteLinkAt(links, 25)
        && validNoteLinkAt(links, 26)
        && validNoteLinkAt(links, 27)
        && validNoteLinkAt(links, 28)
        && validNoteLinkAt(links, 29)
        && validNoteLinkAt(links, 30)
        && validNoteLinkAt(links, 31)
        && validNoteLinkAt(links, 32)
        && validNoteLinkAt(links, 33)
        && validNoteLinkAt(links, 34)
        && validNoteLinkAt(links, 35)
        && validNoteLinkAt(links, 36)
        && validNoteLinkAt(links, 37)
        && validNoteLinkAt(links, 38)
        && validNoteLinkAt(links, 39)
        && validNoteLinkAt(links, 40)
        && validNoteLinkAt(links, 41)
        && validNoteLinkAt(links, 42)
        && validNoteLinkAt(links, 43)
        && validNoteLinkAt(links, 44)
        && validNoteLinkAt(links, 45)
        && validNoteLinkAt(links, 46)
        && validNoteLinkAt(links, 47)
        && validNoteLinkAt(links, 48)
        && validNoteLinkAt(links, 49)
        );
    }
    // ── Course Player AI chat messages (users/{uid}/aiChats) ──────────────
    // Same guarded-index pattern as validNoteLinkAt: rules are not JavaScript,
    // so a bounded list is validated by sampling the first entries and by the
    // list size. The real caps live in utils/lumenChats.js and are asserted
    // against this file by tests/lumenChatCloudSyncContract.test.mjs.
    function validLumenMessageAt(messages, index) {
      return messages.size() <= index || (
        messages[index] is map
        && messages[index].id is string
        && messages[index].id.size() > 0
        && messages[index].id.size() <= 80
        && messages[index].role in ['user', 'assistant']
        && messages[index].content is string
        && messages[index].content.size() <= 20000
        && messages[index].createdAt is number
        && messages[index].status in ['complete', 'error']
      );
    }
    function validLumenMessages(messages) {
      return messages is list && messages.size() <= 120
        && validLumenMessageAt(messages, 0)
        && validLumenMessageAt(messages, 1)
        && validLumenMessageAt(messages, 2)
        && validLumenMessageAt(messages, 3)
        && validLumenMessageAt(messages, 4)
        && validLumenMessageAt(messages, 5)
        && validLumenMessageAt(messages, 6)
        && validLumenMessageAt(messages, 7);
    }
    // ── Device-delivered alerts (users/{uid}/notifications) ───────────────
    // A notification the app itself showed on the device (the My Day /
    // FlowPath foreground clocks and the exact-time local alarms) must also
    // exist on the in-app alerts page — that was the reported "Android
    // notification aa rahe hain lekin alerts page per dikh nahi rahe".
    //
    // The client may therefore create ONLY alerts marked `source == 'device'`,
    // and every field is validated against the same caps
    // utils/deviceNotifications.js applies. `id == notificationId` keeps a
    // document from masquerading as a different alert; the id the client uses
    // is the id the SERVER would have used for the same event, so a locally
    // delivered alert and its server-pushed twin are ONE document. Server
    // documents (source 'system') can never be created or overwritten here.
    function validDeviceNotification(notificationId) {
      return request.resource.data.source == 'device'
        && request.resource.data.id == notificationId
        && request.resource.data.id is string
        && request.resource.data.id.size() > 0
        && request.resource.data.id.size() <= 200
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 600
        && request.resource.data.category in ['store', 'reading', 'course', 'unlock', 'community', 'announcement', 'mayday', 'subscription']
        && request.resource.data.read is bool
        && (request.resource.data.createdAt is number || request.resource.data.createdAt is timestamp)
        && request.resource.data.target is map
        && request.resource.data.target.type is string
        && request.resource.data.target.type in ['product', 'reading', 'announcement', 'course', 'purchases', 'community', 'mayday', 'subscription', 'flowpath']
        && (!('itemId' in request.resource.data.target)
          || (request.resource.data.target.itemId is string && request.resource.data.target.itemId.size() <= 120))
        && (!('section' in request.resource.data.target)
          || (request.resource.data.target.section is string && request.resource.data.target.section.size() <= 40))
        && !request.resource.data.keys().hasAny(['role', 'status', 'purchasedProductIds', 'purchasedProductUpdateIds', 'coinBalance', 'eduCoins', 'subscriptionPlanId', 'subscriptionTier', 'email', 'phone', 'apiKey', 'authorization', 'secret']);
    }
    function validSessionParentAt(uid, parents, index) {
      return parents.size() <= index || (parents[index] is string
        && parents[index].size() > 0 && parents[index].size() <= 40
        && !exists(/databases/$(database)/documents/users/$(uid)/revisionDeletedTests/$(parents[index])));
    }
    function validSessionParents(uid, parents) {
      return parents is list && parents.size() > 0 && parents.size() <= 40
        && (
        validSessionParentAt(uid, parents, 0)
        && validSessionParentAt(uid, parents, 1)
        && validSessionParentAt(uid, parents, 2)
        && validSessionParentAt(uid, parents, 3)
        && validSessionParentAt(uid, parents, 4)
        && validSessionParentAt(uid, parents, 5)
        && validSessionParentAt(uid, parents, 6)
        && validSessionParentAt(uid, parents, 7)
        && validSessionParentAt(uid, parents, 8)
        && validSessionParentAt(uid, parents, 9)
        && validSessionParentAt(uid, parents, 10)
        && validSessionParentAt(uid, parents, 11)
        && validSessionParentAt(uid, parents, 12)
        && validSessionParentAt(uid, parents, 13)
        && validSessionParentAt(uid, parents, 14)
        && validSessionParentAt(uid, parents, 15)
        && validSessionParentAt(uid, parents, 16)
        && validSessionParentAt(uid, parents, 17)
        && validSessionParentAt(uid, parents, 18)
        && validSessionParentAt(uid, parents, 19)
        && validSessionParentAt(uid, parents, 20)
        && validSessionParentAt(uid, parents, 21)
        && validSessionParentAt(uid, parents, 22)
        && validSessionParentAt(uid, parents, 23)
        && validSessionParentAt(uid, parents, 24)
        && validSessionParentAt(uid, parents, 25)
        && validSessionParentAt(uid, parents, 26)
        && validSessionParentAt(uid, parents, 27)
        && validSessionParentAt(uid, parents, 28)
        && validSessionParentAt(uid, parents, 29)
        && validSessionParentAt(uid, parents, 30)
        && validSessionParentAt(uid, parents, 31)
        && validSessionParentAt(uid, parents, 32)
        && validSessionParentAt(uid, parents, 33)
        && validSessionParentAt(uid, parents, 34)
        && validSessionParentAt(uid, parents, 35)
        && validSessionParentAt(uid, parents, 36)
        && validSessionParentAt(uid, parents, 37)
        && validSessionParentAt(uid, parents, 38)
        && validSessionParentAt(uid, parents, 39)
        );
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'wmath84@gmail.com'
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function protectedUserFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'purchasedProductIds', 'referralCode', 'subscriptionPlanId', 'subscriptionTier', 'subscriptionExpiresAt', 'referralUsedCount', 'referralUsedAt']);
    }
    function communityVerificationAllowedOnCreate() {
      return isAdmin()
        || ((!('verified' in request.resource.data) || request.resource.data.verified == false)
          && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false));
    }
    function communityVerificationUnchangedOnUpdate() {
      return isAdmin()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'isVerified']);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();

      // Admin audit log — every FlowPath / admin action appends an
      // entry here. Read-only for admins; never writeable from the
      // client (the server uses the Admin SDK which bypasses rules).
      match /adminAuditLog/{entryId} {
        allow read: if isAdmin();
        allow write: if false;
      }
      match /adminAuditLog/entries/{entryId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      // Scheduled jobs queue — FlowPath writes here for any item
      // with scheduledFor in the future; the existing cron pinger
      // picks the doc up at the right time and fires the FCM /
      // Web Push / in-app bell. Admin-only read + write.
      match /adminScheduledJobs/{jobId} {
        allow read: if isAdmin();
        allow write: if false;
      }
      match /adminScheduledJobs/jobs/{jobId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /publicLeaderboard/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Shareable Study Pack snapshots. Public/unlisted docs are readable by
    // anyone with the opaque id; private packs are owner-only. All writes go
    // through the Admin SDK API so visibility and ownership cannot be spoofed.
    match /studyPacks/{packId} {
      allow read: if resource.data.visibility in ['public', 'unlisted']
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();
      allow create, update, delete: if false;
    }

    // Feature availability is public catalog metadata. The app reads this
    // entry to decide whether a feature still has a subscription gate.
    match /subscriptionFeatures/{featureId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Course entitlements (Part 6 / Part 9) ──────────────────────────────
    // The canonical "this learner owns this course / module / update" records,
    // written ONLY by the server (Admin SDK) inside the payment transaction —
    // `api/_lib/entitlements.ts`. The document id is `{uid}__{entitlementId}`
    // and the document carries the same `uid`, so the read rule pins ownership
    // from the path itself.
    //
    // This collection used to have NO rule of its own, which meant every read
    // fell through to the admin-only catch-all at the bottom of this file: the
    // developer's account resolved all purchased courses, while any other
    // learner's `useCourseAccess` listener was refused with `permission-denied`
    // and their library looked empty. Reads are owner-scoped; writes stay
    // server-only so no client can ever grant itself a course.
    match /entitlements/{entitlementId} {
      // Only the server writes these, so `resource.data.uid` is trustworthy:
      // a learner can read exactly their own entitlements and nothing else.
      allow read: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && !request.resource.data.keys().hasAny(['referralCode', 'subscriptionPlanId', 'subscriptionTier', 'subscriptionExpiresAt', 'referralUsedCount', 'referralUsedAt'])
        && (!('purchasedProductIds' in request.resource.data) || request.resource.data.purchasedProductIds == []);
      allow update: if isOwner(uid) && protectedUserFieldsUnchanged();
      allow write: if isAdmin();

      match /purchases/{productId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.productId == int(productId)
          && request.resource.data.status in ['Completed', 'Verified', 'Active']
          && request.resource.data.source in ['razorpay', 'educoin', 'manual_admin'];
        allow update, delete: if isAdmin();
      }

      match /coinTransactions/{transactionId} {
        allow read, create: if isOwner(uid) || isAdmin();
        allow update, delete: if isAdmin();
      }

      match /subscription/{documentId} {
        allow read: if isOwner(uid) || isAdmin();
        allow update: if documentId == 'current' && isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['renewalReminderOptOut']);
        // Admin-only adjust path: lets support raise (or cap) an existing
        // subscriber's cloud Test Bank capacity mid-term. The owner can only
        // ever change the reminder flag; everything else stays admin/server
        // controlled.
        allow update: if documentId == 'current' && isAdmin();
        allow create, delete: if isAdmin();
      }

      match /myDay/{documentId} {
        allow read: if documentId == 'current' && (isOwner(uid) || isAdmin());
        // The shared My Day API compares item IDs, validates the legacy paid
        // entitlement equivalent of features.hasAny(['my-day']), and consumes
        // the daily-free counter in one transaction. Direct owner writes would bypass it.
        allow create, update, delete: if isAdmin();
      }

      match /myDayUsage/{documentId} {
        allow read: if documentId == 'current' && (isOwner(uid) || isAdmin());
        allow create, update, delete: if isAdmin();
      }

      // ── Joplin My Day workspace (the ONE personal store) ────────────────
      // Rows are Joplin-shaped (`joplinItems` / `joplinTags` /
      // `joplinResources`) plus the universal `scheduledItems` series table.
      //
      // Read/update/delete belong to the owner: editing must work offline and
      // must never consume an allowance. CREATES do not — every new note,
      // notebook, tag, attachment or schedule is written by `/api/joplin/*`,
      // which checks the entitlement and consumes one unit of the same daily
      // counter the legacy planner used (`myDayUsage/current`). The one
      // exception is the conflict copy the sync layer writes when two devices
      // edited the same row: its id ends `_conflict_<epochMs>`, it is the
      // learner's own data, and refusing it would silently drop the loser of a
      // conflict (§96) — so the document id itself is the permission.
      match /joplinItems/{documentId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAdmin()
          || (isOwner(uid) && documentId.matches('.*_conflict_[0-9]+$'));
        allow update: if isAdmin()
          || (isOwner(uid) && resource.data.ownerId == uid && request.resource.data.ownerId == uid);
        allow delete: if isAdmin() || (isOwner(uid) && resource.data.ownerId == uid);
      }

      match /joplinTags/{documentId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAdmin();
        allow update: if isAdmin()
          || (isOwner(uid) && resource.data.ownerId == uid && request.resource.data.ownerId == uid);
        allow delete: if isAdmin() || (isOwner(uid) && resource.data.ownerId == uid);
      }

      match /joplinResources/{documentId} {
        allow read: if isOwner(uid) || isAdmin();
        // Metadata first (server), then the client merges the download URL and
        // the pending flag back into the row it already owns.
        allow create: if isAdmin();
        allow update: if isAdmin()
          || (isOwner(uid) && resource.data.ownerId == uid && request.resource.data.ownerId == uid);
        allow delete: if isAdmin() || (isOwner(uid) && resource.data.ownerId == uid);
      }

      match /scheduledItems/{documentId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAdmin()
          || (isOwner(uid) && documentId.matches('.*_conflict_[0-9]+$'));
        allow update: if isAdmin()
          || (isOwner(uid) && resource.data.ownerId == uid && request.resource.data.ownerId == uid);
        allow delete: if isAdmin() || (isOwner(uid) && resource.data.ownerId == uid);
      }

      // Web Clipper secrets. The pairing code and the token are stored as
      // hashes and only ever read by the server: `codeHash` is what a claim
      // compares against, `tokenHash` is what a clip authenticates with. A
      // client that could read this collection could enumerate live extensions
      // (and a client that could write it could mint one), so neither is
      // allowed — "Web Clipper" in My Day talks to `/api/joplin/clipper`.
      match /joplinClipperCodes/{documentId} {
        allow read, write: if isAdmin();
      }

      match /joplinClipperTokens/{documentId} {
        allow read, write: if isAdmin();
      }

      // Workspace metadata: the sync profile, the migration marker (V1, the
      // switch that retires the legacy planner) and the sync state. Owner
      // writable on purpose — a device must be able to record "phase 2
      // verified" while offline, and none of it grants anything server-side.
      match /joplinMeta/{documentId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // ── Learner-authored courses (My Study Library → "+") ───────────────
      // ONE document per course: cover image, title, nested modules, resources
      // and Brain (MCQ) practice questions — the tree the Course Player opens
      // at `#/my-course/<id>`.
      //
      // Ownership is re-derived from the PATH, so a browser can never read or
      // write another learner's course. The learner owns the whole tree
      // outright (no entitlement, no plan limit, nothing purchasable), so —
      // exactly like `mindMaps` — direct owner writes are permitted: the
      // offline queue then means a course built on a flaky connection is never
      // lost. The caps below keep one document far away from Firestore's 1 MB
      // limit (the client enforces the same numbers while editing).
      match /myCourses/{courseId} {
        allow read, delete: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && (!('description' in request.resource.data) || request.resource.data.description.size() <= 600)
          && (!('coverImage' in request.resource.data) || request.resource.data.coverImage is string)
          && request.resource.data.modules is list
          && request.resource.data.modules.size() <= 200
          && request.resource.data.schemaVersion is int
          && !request.resource.data.keys().hasAny(['role', 'status', 'purchasedProductIds', 'purchasedProductUpdateIds', 'coinBalance', 'eduCoins', 'subscriptionPlanId', 'subscriptionTier']);
      }

      match /courseProgress/{productId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.productId == productId
          && !request.resource.data.keys().hasAny(['role', 'status', 'purchasedProductIds', 'purchasedProductUpdateIds', 'coinBalance', 'eduCoins']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /session/{sessionId} {
        allow read: if sessionId == 'current' && isOwner(uid);
        allow create, update: if sessionId == 'current'
          && isOwner(uid)
          && request.resource.data.uid == uid
          && !request.resource.data.keys().hasAny(['role', 'status', 'purchasedProductIds']);
        allow delete: if sessionId == 'current' && isOwner(uid);
      }

      // ── Alerts (the bell badge + the in-app Notifications page) ──────────
      // Server-generated alerts (renewals, My Day pushes, FlowPath jobs,
      // product announcements — `source == 'system'`) stay admin-only, exactly
      // as before. The owner may additionally create the alerts the DEVICE
      // itself delivered, marked `source == 'device'` and validated by
      // validDeviceNotification above; that is what makes a system
      // notification visible on the in-app alerts page too. Marking anything
      // (server or device) read remains an owner action.
      match /notifications/{notificationId} {
        allow read: if isOwner(uid) || isAdmin();
        allow update: if isOwner(uid) && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt'])
          || (resource.data.source == 'device' && validDeviceNotification(notificationId))
        );
        allow create: if isAdmin() || (isOwner(uid) && validDeviceNotification(notificationId));
        // Dismissing a card is a USER action on their OWN alert list: the page
        // deletes the mirrored doc so the swipe-to-dismiss sticks across
        // snapshots and devices (the server never reading it again is fine —
        // every alert is also delivered as a push).
        allow delete: if isAdmin() || isOwner(uid);
      }

      // Per-student Google Drive personal copies. One doc per master file
      // id, carrying the student's own copyFileId. The copy itself lives in
      // the STUDENT's Drive; this is only the id mapping so the same copy
      // reopens on every device.
      match /driveCopies/{sourceFileId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.sourceFileId == sourceFileId
          && request.resource.data.copyFileId is string
          && request.resource.data.copyFileId.size() > 8
          && request.resource.data.copyFileId.size() <= 200;
        allow delete: if isOwner(uid) || isAdmin();
      }

      // ── Course Player NOTES ────────────────────────────────────────────
      // ONE document per note, exactly like `mindMaps` below: the learner's own
      // writing, private to them, written straight from the client so
      // Firestore's offline queue keeps a note taken on a flaky connection.
      //
      // The Notes tab uses the shared `src/course/useCourseNotes.ts` and
      // `src/course/cloudNotes.ts` store, scoped by `productId` —
      // `String(product.id)` for a purchased course, `mine-<courseId>` for a
      // learner-authored course, and `__library__` for AI personal notes.
      //
      // Ownership is re-derived from the PATH and the document id must equal
      // the `id` field inside it, so a browser can never read — or write into —
      // another learner's notes. The caps mirror `utils/courseNotes.js`
      // exactly, so a payload the client built can never be rejected here.
      match /notes/{noteId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.id == noteId
          && request.resource.data.id is string
          && request.resource.data.id.size() > 0
          && request.resource.data.id.size() <= 80
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.productId.size() <= 120
          && request.resource.data.html is string
          && request.resource.data.html.size() <= 60000
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 20000
          && request.resource.data.links is list
          && request.resource.data.links.size() <= 50
          && validNoteLinks(request.resource.data.links)
          && request.resource.data.moduleId is string
          && request.resource.data.resourceId is string
          && request.resource.data.personalModuleId is string
          && request.resource.data.personalResourceId is string
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number
          && request.resource.data.schemaVersion is int
          && (!('aiGenerated' in request.resource.data) || request.resource.data.aiGenerated is bool)
          && (!('aiKind' in request.resource.data)
            || request.resource.data.aiKind in ['answer', 'summary', 'explanation', 'question', 'flashcard', 'plan'])
          && !request.resource.data.keys().hasAny(['role', 'status', 'purchasedProductIds', 'purchasedProductUpdateIds', 'coinBalance', 'eduCoins', 'subscriptionPlanId', 'subscriptionTier', 'email', 'phone', 'apiKey', 'authorization', 'secret']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      // ── Course Player AI CHAT (Lumen) ────────────────────────────────────
      // ONE document per conversation, exactly like `notes` above: the
      // learner's own questions and answers, private to them, written straight
      // from the client so Firestore's offline queue protects a chat typed on
      // a flaky connection and so the same history opens on every device.
      //
      // Before this block existed the whole conversation lived in React state
      // inside src/lumen/App.tsx and disappeared the moment the player
      // unmounted ("course player ke andar jo AI chats hote hain vah save nahin
      // ho rahe"). The caps mirror utils/lumenChats.js exactly, so a payload
      // the client built can never be rejected here.
      //
      // Inline `data:` image bytes are NEVER written (the client strips them
      // before the write): a screenshot-heavy chat would otherwise march
      // straight into Firestore's 1 MB document limit and every later save
      // would fail.
      match /aiChats/{chatId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.id == chatId
          && request.resource.data.id is string
          && request.resource.data.id.size() > 0
          && request.resource.data.id.size() <= 80
          && request.resource.data.productId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.productId.size() <= 120
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.course is string
          && request.resource.data.course.size() <= 160
          && request.resource.data.courseShort is string
          && request.resource.data.courseShort.size() <= 160
          && request.resource.data.pinned is bool
          && request.resource.data.modelId is string
          && request.resource.data.modelId.size() <= 80
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number
          && request.resource.data.schemaVersion is int
          && validLumenMessages(request.resource.data.messages)
          && !request.resource.data.keys().hasAny(['role', 'status', 'purchasedProductIds', 'purchasedProductUpdateIds', 'coinBalance', 'eduCoins', 'subscriptionPlanId', 'subscriptionTier', 'email', 'phone', 'apiKey', 'authorization', 'secret']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Per-student Course Player mind maps. A module holds as MANY maps as
      // the learner wants (same as notes), each in its own document, so every
      // student's diagrams are private and each module keeps its own set.
      // The doc id is the composite `{uid}__{productId}__{moduleId}` for the
      // first map (key `main`, the id every pre-multi-map doc already uses)
      // and `…__{mapKey}` for the rest — both built by `mindMapDocId()` in
      // utils/mindMapTree.js. The rules re-derive the id here so one student
      // cannot write into another's namespace by choosing an id, and the map
      // key inside the document must match the key in the id so a doc cannot
      // masquerade as a different map. Writes go straight from the client
      // (the map is the learner's own data and needs Firestore's offline
      // queue to survive a dropped connection mid-session).
      match /mindMaps/{mapId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.productId is string
          && request.resource.data.moduleId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.moduleId.size() > 0
          && request.resource.data.mapKey is string
          && request.resource.data.mapKey.size() > 0
          && request.resource.data.mapKey.size() <= 40
          && request.resource.data.mapKey.matches('^[a-z0-9-]+$')
          && (
            (request.resource.data.mapKey == 'main'
              && mapId == uid + '__' + request.resource.data.productId + '__' + request.resource.data.moduleId)
            || mapId == uid + '__' + request.resource.data.productId + '__' + request.resource.data.moduleId + '__' + request.resource.data.mapKey
          )
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && (request.resource.data.version is int || request.resource.data.version is float)
          && request.resource.data.rootTopic is string
          && request.resource.data.rootTopic.size() <= 400
          && request.resource.data.nodes is list
          // Mirrors MAX_MIND_MAP_NODES in utils/mindMapTree.js. A learner's
          // own map is capped so one runaway doc cannot approach the 1 MB
          // document limit and start failing every write.
          && request.resource.data.nodes.size() <= 600
          && (request.resource.data.nodeCount is int || request.resource.data.nodeCount is float)
          && request.resource.data.nodeCount <= 601
          && !request.resource.data.keys().hasAny(['role', 'status', 'purchasedProductIds', 'purchasedProductUpdateIds', 'coinBalance', 'eduCoins', 'subscriptionPlanId', 'subscriptionTier']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Course Player → Sketch. One Excalidraw board per learner per course
      // MODULE, written straight from the client like the mind maps above
      // (same offline-queue reasoning). The id is re-derived here —
      // `{uid}__{productId}__{moduleId}` for the default board, `…__{key}`
      // for any future named board — so a learner cannot pick an id that
      // lands in somebody else's namespace, and the key inside the document
      // must match the key in the id.
      //
      // The scene is a JSON STRING, not a map: Excalidraw elements contain
      // `points: [[x, y], …]`, and Firestore rejects nested arrays outright.
      // The rules therefore validate the envelope (ownership, identity, the
      // size ceiling) and treat the payload itself as opaque text — mirroring
      // MAX_SKETCH_SCENE_CHARS / MAX_SKETCH_ELEMENTS in utils/sketchScene.js
      // so one runaway board can never creep up on the 1 MB document limit
      // and start failing every write.
      match /sketches/{sketchId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.productId is string
          && request.resource.data.moduleId is string
          && request.resource.data.productId.size() > 0
          && request.resource.data.moduleId.size() > 0
          && request.resource.data.sketchKey is string
          && request.resource.data.sketchKey.size() > 0
          && request.resource.data.sketchKey.size() <= 40
          && request.resource.data.sketchKey.matches('^[a-z0-9-]+$')
          && (
            (request.resource.data.sketchKey == 'main'
              && sketchId == uid + '__' + request.resource.data.productId + '__' + request.resource.data.moduleId)
            || sketchId == uid + '__' + request.resource.data.productId + '__' + request.resource.data.moduleId + '__' + request.resource.data.sketchKey
          )
          && (request.resource.data.version is int || request.resource.data.version is float)
          && request.resource.data.scene is string
          && request.resource.data.scene.size() <= 900000
          && (request.resource.data.elementCount is int || request.resource.data.elementCount is float)
          && request.resource.data.elementCount <= 1500
          && (!request.resource.data.keys().hasAny(['resourceId']) || (request.resource.data.resourceId is string && request.resource.data.resourceId.size() <= 200))
          && (!request.resource.data.keys().hasAny(['resourceName']) || (request.resource.data.resourceName is string && request.resource.data.resourceName.size() <= 200))
          && !request.resource.data.keys().hasAny(['role', 'status', 'purchasedProductIds', 'purchasedProductUpdateIds', 'coinBalance', 'eduCoins', 'subscriptionPlanId', 'subscriptionTier']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Course Player → Sketch PERSONAL LIBRARY. ONE document per learner
      // (`users/{uid}/sketchLibraries/main`) holding the Excalidraw library
      // items as a JSON string — same nested-array reasoning as the boards
      // above, and the same size ceiling (see SKETCH_LIBRARY_MAX_CHARS /
      // SKETCH_LIBRARY_MAX_ITEMS in src/course/useSketchLibrary.ts).
      //
      // This document is what makes the library panel persist at all: the
      // editor itself is memory-only, so without a host adapter every item a
      // learner saved vanished when the Sketch tab unmounted. Owner-only, doc
      // id fixed to `main`, and the payload is opaque text.
      match /sketchLibraries/{libraryId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && libraryId == 'main'
          && request.resource.data.uid == uid
          && request.resource.data.version is number
          && request.resource.data.items is string
          && request.resource.data.items.size() <= 900000
          && request.resource.data.itemCount is number
          && request.resource.data.itemCount <= 500
          && request.resource.data.truncated is bool
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number
          && !request.resource.data.keys().hasAny(['role', 'status', 'purchasedProductIds', 'purchasedProductUpdateIds', 'coinBalance', 'eduCoins', 'subscriptionPlanId', 'subscriptionTier']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Course Player → READ library, the LEARNER's OWN PDFs. One document per
      // uploaded file (`users/{uid}/readUploads/{uploadId}`); the bytes live in
      // Storage under `userReadUploads/{uid}/{uploadId}-{slug}.pdf` (see the
      // `userReadUploads` match in storage.rules).
      //
      // Ownership comes from the PATH, never from the payload: a document can
      // only exist in its author's own namespace, its id must match the field
      // inside it, and `storagePath` must resolve to this learner's folder with
      // a PDF name — so a hand-written document can never alias somebody else's
      // object into this library. The numbers are the same ceilings
      // utils/readUploads.js clamps to (100 MiB, 20000 pages, 100000
      // annotations), and the payload the learner saves is a PDF, never HTML.
      match /readUploads/{uploadId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.uploadId == uploadId
          && uploadId.matches('^[A-Za-z0-9][A-Za-z0-9-]{5,119}$')
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 160
          && request.resource.data.module is string
          && request.resource.data.module.size() <= 60
          && request.resource.data.storagePath is string
          && request.resource.data.storagePath.size() > 0
          && request.resource.data.storagePath.size() <= 400
          && request.resource.data.storagePath.split('/').size() == 3
          && request.resource.data.storagePath.split('/')[0] == 'userReadUploads'
          && request.resource.data.storagePath.split('/')[1] == uid
          && request.resource.data.storagePath.split('/')[2].matches('^[A-Za-z0-9][A-Za-z0-9._-]*[.]pdf$')
          && request.resource.data.url is string
          && request.resource.data.url.size() <= 2048
          && request.resource.data.contentType == 'application/pdf'
          && request.resource.data.sizeBytes is number
          && request.resource.data.sizeBytes >= 0
          && request.resource.data.sizeBytes <= 104857600
          && request.resource.data.pageCount is number
          && request.resource.data.pageCount >= 0
          && request.resource.data.pageCount <= 20000
          && request.resource.data.lastPage is number
          && request.resource.data.lastPage >= 1
          && request.resource.data.lastPage <= 20000
          && request.resource.data.hasAnnotations is bool
          && request.resource.data.annotationCount is number
          && request.resource.data.annotationCount >= 0
          && request.resource.data.annotationCount <= 100000
          && request.resource.data.createdAt is number
          && request.resource.data.updatedAt is number
          && request.resource.data.lastOpenedAt is number
          && (!request.resource.data.keys().hasAny(['annotatedAt']) || request.resource.data.annotatedAt is number)
          && !request.resource.data.keys().hasAny(['role', 'status', 'purchasedProductIds', 'purchasedProductUpdateIds', 'coinBalance', 'eduCoins', 'subscriptionPlanId', 'subscriptionTier']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /webPushSubscriptions/{subscriptionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.endpoint is string
          && request.resource.data.endpoint.size() > 8
          && request.resource.data.endpoint.size() <= 2000
          && request.resource.data.p256dh is string
          && request.resource.data.p256dh.size() > 8
          && request.resource.data.p256dh.size() <= 500
          && request.resource.data.auth is string
          && request.resource.data.auth.size() > 4
          && request.resource.data.auth.size() <= 200
          && !request.resource.data.keys().hasAny(['email', 'phone', 'apiKey', 'authorization', 'secret', 'rawHtml']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      // Capacitor / TWA Android device tokens (FCM). The TWA's
      // PushNotifications plugin delivers an FCM token on every fresh
      // install and again every time Google Play Services rotates the
      // token. The id is the SHA-256 of the token, so re-registering
      // with the same value is a no-op and a different value writes a
      // new doc. Server-side dispatcher in api/_lib/fcm.ts reads this
      // collection to fan out guaranteed-delivery Android pushes.
      match /fcmTokens/{tokenId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.token is string
          && request.resource.data.token.size() > 8
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['android', 'ios', 'web']
          && !request.resource.data.keys().hasAny(['email', 'phone', 'apiKey', 'authorization', 'secret', 'rawHtml']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      // FlowPath activities — the master copy the FlowPath dashboard
      // reads. Created by the server-side FlowPath control multiplexer
      // (api/_lib/flowpathControl.ts), which the user can also drive
      // from the My Day / Revision pages (those writes are mirrored
      // here so the dashboard always shows the full picture).
      // Reads: owner + admin. Writes: admin only (the server is the
      // single point of truth for what ends up in here; the user's
      // own My Day / Revision actions go through the original
      // handlers and the server mirrors them to this collection).
      match /flowpathActivities/{activityId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if isAdmin();
      }


      // Cloud Revision Test Bank. Test documents and capacity counters are
      // server-authoritative (Admin SDK only) so a client cannot bypass its
      // plan limit. Owner-scoped progress documents may be updated directly so
      // Firestore's offline queue can preserve every answer while taking a test.
      match /revisionTests/{testId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /revisionUsage/{documentId} {
        allow read: if documentId == 'current' && (isOwner(uid) || isAdmin());
        allow create, update, delete: if isAdmin();
      }

      // Server-only deletion tombstones prevent another offline device from
      // re-importing a test that the learner permanently deleted.
      match /revisionDeletedTests/{testId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /revisionAttempts/{attemptId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.testId is number
          && request.resource.data.testKey is string
          && request.resource.data.testKey.size() > 0
          && request.resource.data.testKey.size() <= 40
          && !exists(/databases/$(database)/documents/users/$(uid)/revisionDeletedTests/$(request.resource.data.testKey))
          && request.resource.data.attempt is map
          && request.resource.data.answers is list
          && request.resource.data.answers.size() <= 100
          && !request.resource.data.keys().hasAny(['apiKey', 'authorization', 'secret', 'role']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /revisionItems/{itemId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.testId is number
          && request.resource.data.testKey is string
          && request.resource.data.testKey.size() > 0
          && request.resource.data.testKey.size() <= 40
          && !exists(/databases/$(database)/documents/users/$(uid)/revisionDeletedTests/$(request.resource.data.testKey))
          && request.resource.data.item is map
          && !request.resource.data.keys().hasAny(['apiKey', 'authorization', 'secret', 'role']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /revisionSessions/{sessionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.testKey is string
          && request.resource.data.testKey.size() > 0
          && request.resource.data.testKey.size() <= 40
          && !exists(/databases/$(database)/documents/users/$(uid)/revisionDeletedTests/$(request.resource.data.testKey))
          && (!('parentTestKeys' in request.resource.data)
            || validSessionParents(uid, request.resource.data.parentTestKeys))
          && request.resource.data.session is map
          && request.resource.data.answers is list
          && request.resource.data.answers.size() <= 100
          && !request.resource.data.keys().hasAny(['apiKey', 'authorization', 'secret', 'role']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /aiUsage/{documentId} {
        // Usage, in-flight reservations, plan snapshots and token-cost totals
        // are written only by the transactional Admin SDK generation API.
        // The Admin SDK bypasses Firestore rules; no browser client (including
        // an admin session) may mint, refund or otherwise manipulate quota.
        allow read: if documentId == 'current' && (isOwner(uid) || isAdmin());
        allow create, update, delete: if false;
      }

      match /aiMentorChats/{chatId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.ownerId == uid
          && request.resource.data.userId == uid
          && request.resource.data.source == 'course_player_ai_mentor'
          && request.resource.data.expiresAt is string
          && request.resource.data.expiresAtMs is number
          && request.resource.data.expiresAtMs > request.time.toMillis()
          && request.resource.data.messageCount is number
          && request.resource.data.messageCount <= 100
          && !request.resource.data.keys().hasAny(['apiKey', 'authorization', 'secret', 'rawApiKey']);
        allow update: if isOwner(uid)
          && resource.data.ownerId == uid
          && request.resource.data.ownerId == uid
          && request.resource.data.userId == uid
          && request.resource.data.source == 'course_player_ai_mentor'
          && request.resource.data.expiresAt is string
          && request.resource.data.expiresAtMs is number
          && request.resource.data.expiresAtMs > request.time.toMillis()
          && request.resource.data.messageCount is number
          && request.resource.data.messageCount <= 100
          && !request.resource.data.keys().hasAny(['apiKey', 'authorization', 'secret', 'rawApiKey']);
        allow delete: if isOwner(uid) || isAdmin() || resource.data.expiresAtMs <= request.time.toMillis();
      }

      // ── Personal Course Modules ("My Modules") ──────────────────────────
      // Learner-created study content inside a course they can access. The
      // path itself is under the owner's uid namespace, so one learner can
      // never read another learner's modules and the ownerUid can never be
      // spoofed (Firestore rules re-derive ownership from the path).
      //
      // Entitlement (paid feature), per-plan limits and allowed resource
      // types are enforced by the AUTHORITATIVE server API
      // (`/api/personal-course`, api/_lib/personalCourse.ts) inside
      // Firestore transactions — a browser client can never enable the
      // feature by editing local state or request payloads. Those checks
      // need cross-document reads + transactional counting that rules cannot
      // express, so direct CLIENT WRITES are denied here; the server's Admin
      // SDK performs every create/update/delete. Reads are allowed so the
      // Course Player can subscribe live to the learner's own content.
      //
      // Official course documents (siteProducts etc.) are never reachable
      // through these paths, so this feature cannot mutate instructor
      // content by construction.
      match /personalCourseModules/{moduleId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if false;

        match /resources/{resourceId} {
          allow read: if isOwner(uid) || isAdmin();
          allow create, update, delete: if false;
        }
      }

      // Server-maintained usage counters for one user + course (module and
      // total-resource counts). Readable by the owner for live limit UI;
      // written only by the Admin SDK API layer.
      match /personalCourseUsage/{productId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if false;
      }

      // ── Personal Module AI Study Engine ("Ask this Module") ────────────
      // Everything the module AI derives about ONE learner's OWN material:
      //   personalAi/content/items/{resourceId}  — cached extracted text
      //   personalAi/artifacts/items/{id}        — summaries / questions /
      //                                            flashcards / study plans
      //   personalAi/threads/items/{moduleId}    — the module's AI conversation
      //   personalAi/evidence/items/{moduleId}   — weak-topic evidence
      //
      // Same posture as personalCourseModules: the path lives under the owner's
      // uid namespace (so ownership is re-derived from the path and can never be
      // spoofed by a payload field), reads are owner/admin only, and ALL writes
      // go through the authoritative API (`/api/personal-ai`,
      // api/_lib/personalAi.ts) with the Admin SDK. Denying client writes means
      // a browser can never plant AI content in someone else's namespace, forge
      // provenance, re-own an artifact, or bypass the allowance ledger — the AI
      // quota itself stays in `aiUsage/current`, which is already server-only.
      match /personalAi/{bucket} {
        allow read, write: if false;

        match /items/{itemId} {
          allow read: if isOwner(uid) || isAdmin();
          allow create, update, delete: if false;
        }
      }
    }

    match /siteProducts/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public surfaces may read published reviews only. Signed-in learners can
    // publish a review for themselves (it becomes visible immediately and is
    // counted in the live rating aggregate); only an admin can edit or delete
    // a review. Home/PDP order the published result by the latest createdAt
    // value on the client, so no composite index is needed.
    match /siteReviews/{reviewId} {
      allow read: if resource.data.status == 'published'
        || (signedIn() && (
          resource.data.customerId == request.auth.uid
          || resource.data.userId == request.auth.uid
          || resource.data.uid == request.auth.uid
        ));
      allow create: if signedIn()
        && request.resource.data.status in ['pending', 'published']
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.verifiedPurchase is bool
        && (request.resource.data.customerId == request.auth.uid
          || request.resource.data.userId == request.auth.uid
          || request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /siteOrders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }


    match /community_feed/{postId} {
      allow read: if signedIn();
      allow create: if (signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.postType in ['text', 'image', 'poll'])
        || (isAdmin() && request.resource.data.source == 'admin');
      allow update: if signedIn();
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);

      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.status in ['active', 'sent']
          && !request.resource.data.keys().hasAny(['email', 'phone', 'apiKey', 'authorization', 'secret', 'rawHtml']);
        allow update: if isAdmin()
          || (signedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.senderId == resource.data.senderId
            && !request.resource.data.keys().hasAny(['email', 'phone', 'apiKey', 'authorization', 'secret', 'rawHtml']));
        allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      }
    }

    match /community_status/{statusId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.type in ['text', 'image', 'poll'];
      allow update: if signedIn();
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /community_upload_quotas/{quotaId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if signedIn()
        && quotaId in [request.auth.uid + '_creator', request.auth.uid + '_status']
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.kind in ['creator', 'status']
        && request.resource.data.keys().hasOnly(['userId', 'kind', 'usedTypes', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /community_storage_meta/{metaId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && metaId == 'usage'
        && request.resource.data.keys().hasOnly(['usedBytes', 'limitBytes', 'bucketBytes', 'updatedAt'])
        && request.resource.data.usedBytes is number
        && request.resource.data.usedBytes >= 0;
      allow delete: if isAdmin();
    }

    match /community_profiles/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && communityVerificationAllowedOnCreate()
        && request.resource.data.keys().hasOnly([
          'uid', 'id', 'userId', 'ownerId', 'username', 'displayName', 'name', 'photoURL', 'avatar', 'role', 'bio',
          'subjects', 'masterTags', 'creatorCategory', 'searchableText', 'searchTokens',
          'followers', 'followerCount', 'followingCount', 'postCount', 'mutual',
          'verified', 'isVerified', 'isCreator', 'isPublic', 'isSuspended', 'source', 'isOnline', 'lastActiveAt', 'lastFollowedAt', 'lastFollowerAt', 'createdAt', 'updatedAt'
        ]);
      allow update: if isOwner(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && communityVerificationUnchangedOnUpdate()
        && request.resource.data.keys().hasOnly([
          'uid', 'id', 'userId', 'ownerId', 'username', 'displayName', 'name', 'photoURL', 'avatar', 'role', 'bio',
          'subjects', 'masterTags', 'creatorCategory', 'searchableText', 'searchTokens',
          'followers', 'followerCount', 'followingCount', 'postCount', 'mutual',
          'verified', 'isVerified', 'isCreator', 'isPublic', 'isSuspended', 'source', 'isOnline', 'lastActiveAt', 'lastFollowedAt', 'lastFollowerAt', 'createdAt', 'updatedAt'
        ]);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['followerCount', 'followingCount', 'updatedAt', 'lastFollowedAt', 'lastFollowerAt'])
        && (!request.resource.data.diff(resource.data).changedKeys().hasAny(['followerCount']) || request.resource.data.followerCount in [resource.data.followerCount + 1, resource.data.followerCount - 1])
        && (!request.resource.data.diff(resource.data).changedKeys().hasAny(['followingCount']) || request.resource.data.followingCount in [resource.data.followingCount + 1, resource.data.followingCount - 1])
        && (!('followerCount' in request.resource.data) || request.resource.data.followerCount >= 0)
        && (!('followingCount' in request.resource.data) || request.resource.data.followingCount >= 0);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn() && resource.data.isPublic != false && resource.data.isSuspended != true && resource.data.hidden != true && resource.data.blocked != true;
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && communityVerificationAllowedOnCreate()
        && request.resource.data.keys().hasOnly([
          'uid', 'id', 'userId', 'ownerId', 'username', 'displayName', 'name', 'photoURL', 'avatar', 'role', 'bio',
          'subjects', 'masterTags', 'creatorCategory', 'searchableText', 'searchTokens',
          'followerCount', 'followingCount', 'postCount', 'isCreator', 'isVerified', 'verified', 'isPublic', 'isSuspended',
          'isOnline', 'lastActiveAt', 'lastFollowedAt', 'lastFollowerAt', 'createdAt', 'updatedAt'
        ]);
      allow update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && communityVerificationUnchangedOnUpdate()
        && request.resource.data.keys().hasOnly([
          'uid', 'id', 'userId', 'ownerId', 'username', 'displayName', 'name', 'photoURL', 'avatar', 'role', 'bio',
          'subjects', 'masterTags', 'creatorCategory', 'searchableText', 'searchTokens',
          'followerCount', 'followingCount', 'postCount', 'isCreator', 'isVerified', 'verified', 'isPublic', 'isSuspended',
          'isOnline', 'lastActiveAt', 'lastFollowedAt', 'lastFollowerAt', 'createdAt', 'updatedAt'
        ]);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['followerCount', 'followingCount', 'updatedAt', 'lastFollowedAt', 'lastFollowerAt'])
        && (!request.resource.data.diff(resource.data).changedKeys().hasAny(['followerCount']) || request.resource.data.followerCount in [resource.data.followerCount + 1, resource.data.followerCount - 1])
        && (!request.resource.data.diff(resource.data).changedKeys().hasAny(['followingCount']) || request.resource.data.followingCount in [resource.data.followingCount + 1, resource.data.followingCount - 1])
        && (!('followerCount' in request.resource.data) || request.resource.data.followerCount >= 0)
        && (!('followingCount' in request.resource.data) || request.resource.data.followingCount >= 0);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /community_follows/{followId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followingId
        && request.resource.data.status == 'active';

      allow update: if signedIn()
        && resource.data.followerId == request.auth.uid
        && request.resource.data.followerId == resource.data.followerId
        && request.resource.data.followingId == resource.data.followingId
        && request.resource.data.status in ['active', 'removed'];

      allow delete: if isAdmin()
        || (signedIn() && resource.data.followerId == request.auth.uid);
    }


    match /community_notifications/{notificationId} {
      allow read: if signedIn()
        && (isAdmin()
          || resource.data.recipientId == request.auth.uid
          || resource.data.actorId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != ''
        && request.resource.data.type in ['reply', 'masterTag', 'status', 'creator', 'follow', 'share']
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.createdAt is number
        && !request.resource.data.keys().hasAny(['email', 'phone', 'apiKey', 'authorization', 'secret', 'rawHtml']);

      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read', 'readAt', 'updatedAt']);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.recipientId == request.auth.uid);
    }

    match /private_chats/{chatId} {
      function isShareParticipant() {
        return signedIn()
          && resource.data.participantMap[request.auth.uid] == true;
      }

      function isIncomingShareParticipant() {
        return signedIn()
          && request.resource.data.participantMap[request.auth.uid] == true
          && request.auth.uid in request.resource.data.participants;
      }

      allow read: if isShareParticipant();

      allow create: if isIncomingShareParticipant()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participantMap is map
        && request.resource.data.participantMap.keys().hasOnly(request.resource.data.participants)
        && request.resource.data.participantMap[request.resource.data.participants[0]] == true
        && request.resource.data.participantMap[request.resource.data.participants[1]] == true
        && request.resource.data.participantNames is map
        && request.resource.data.participantAvatars is map
        && request.resource.data.unreadCounts is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastMessageType == 'shared_item'
        && (!request.resource.data.keys().hasAny(['sharedItemCount'])
          || (request.resource.data.sharedItemCount is int
            && request.resource.data.sharedItemCount >= 0))
        && request.resource.data.keys().hasOnly([
          'participants', 'participantMap', 'participantNames', 'participantAvatars',
          'createdAt', 'updatedAt', 'lastMessage', 'lastMessageType',
          'lastMessageAt', 'lastSenderId', 'unreadCounts', 'sharedItemCount', 'pinnedMessageId'
        ]);

      allow update: if isShareParticipant()
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.participantMap == resource.data.participantMap
        && request.resource.data.createdAt == resource.data.createdAt
        && (!request.resource.data.keys().hasAny(['sharedItemCount'])
          || (request.resource.data.sharedItemCount is int
            && request.resource.data.sharedItemCount >= 0))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participantNames', 'participantAvatars', 'updatedAt', 'lastMessage',
          'lastMessageType', 'lastMessageAt', 'lastSenderId', 'unreadCounts',
          'sharedItemCount', 'pinnedMessageId'
        ]);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/private_chats/$(chatId));
        }

        function isMessageParticipant() {
          return signedIn()
            && parentChat().data.participantMap[request.auth.uid] == true;
        }

        allow read: if isMessageParticipant();

        allow create: if isMessageParticipant()
          && request.resource.data.id == messageId
          && request.resource.data.conversationId == chatId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId is string
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.receiverId in parentChat().data.participants
          && request.resource.data.senderName is string
          && request.resource.data.receiverName is string
          && request.resource.data.type == 'shared_item'
          && request.resource.data.sharedItem is map
          && request.resource.data.sharedItem.sourceType in ['status', 'feed_message']
          && request.resource.data.sharedItem.sourceCollection in ['community_status', 'community_feed']
          && request.resource.data.sharedItem.sourceId is string
          && request.resource.data.sharedItem.title is string
          && request.resource.data.sharedItem.previewText is string
          && request.resource.data.sharedItem.keys().hasOnly([
            'sourceType', 'sourceId', 'sourceCollection', 'sourceOwnerId',
            'title', 'previewText', 'imageUrl', 'imageLayout', 'storagePath',
            'originalCreatedAt', 'originalExpiresAt', 'postType', 'pollOptions',
            'pollVotes', 'mediaType', 'mediaUrl'
          ])
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt == request.time
          && request.resource.data.readBy is map
          && request.resource.data.readBy[request.auth.uid] == true
          && request.resource.data.status == 'sent'
          && request.resource.data.keys().hasOnly([
            'id', 'conversationId', 'senderId', 'receiverId', 'senderName',
            'receiverName', 'type', 'sharedItem', 'createdAt', 'readBy', 'status'
          ]);

        allow update: if false;

        allow delete: if isAdmin()
          || (signedIn()
            && resource.data.senderId == request.auth.uid
            && resource.data.type == 'shared_item'
            && resource.data.createdAt is timestamp
            && request.time <= resource.data.createdAt + duration.value(30, 'm'));
      }
    }

    match /community_master_tags/{tagId} {
      allow read: if !('visibility' in resource.data) || resource.data.visibility == 'public' || (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.visibility in ['public', 'followers', 'private']
        && request.resource.data.status == 'active'
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 20
        && request.resource.data.message.size() <= 500
        && request.resource.data.category is string
        && request.resource.data.normalizedSearchText is string
        && !('authorEmail' in request.resource.data)
        && !('targetMasterEmail' in request.resource.data)
        && !('phone' in request.resource.data);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.authorId == resource.data.authorId)
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedByUsers', 'reactions', 'reactionUsers', 'updatedAt']));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /siteSupportTickets/{ticketId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }


    match /wallets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /coinTransactions/{transactionId} {
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/coinTransactions/$(transactionId))
          || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /productUnlocks/{unlockId} {
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/productUnlocks/$(unlockId))
          || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /youtubeWatchRewards/{rewardId} {
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/youtubeWatchRewards/$(rewardId))
          || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /watchProgress/{progressId} {
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/watchProgress/$(progressId))
          || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /pdfDownloadRewards/{rewardId} {
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/pdfDownloadRewards/$(rewardId))
          || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
