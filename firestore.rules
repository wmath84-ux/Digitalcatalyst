rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'wmath84@gmail.com'
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function protectedUserFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'purchasedProductIds', 'referralCode', 'subscriptionPlanId', 'subscriptionTier', 'subscriptionExpiresAt', 'referralUsedCount', 'referralUsedAt']);
    }
    function communityVerificationAllowedOnCreate() {
      return isAdmin()
        || ((!('verified' in request.resource.data) || request.resource.data.verified == false)
          && (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false));
    }
    function communityVerificationUnchangedOnUpdate() {
      return isAdmin()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'isVerified']);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /publicLeaderboard/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Feature availability is public catalog metadata. The app reads this
    // entry to decide whether a feature still has a subscription gate.
    match /subscriptionFeatures/{featureId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'active'
        && !request.resource.data.keys().hasAny(['referralCode', 'subscriptionPlanId', 'subscriptionTier', 'subscriptionExpiresAt', 'referralUsedCount', 'referralUsedAt'])
        && (!('purchasedProductIds' in request.resource.data) || request.resource.data.purchasedProductIds == []);
      allow update: if isOwner(uid) && protectedUserFieldsUnchanged();
      allow write: if isAdmin();

      match /purchases/{productId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.productId == int(productId)
          && request.resource.data.status in ['Completed', 'Verified', 'Active']
          && request.resource.data.source in ['razorpay', 'educoin', 'manual_admin'];
        allow update, delete: if isAdmin();
      }

      match /coinTransactions/{transactionId} {
        allow read, create: if isOwner(uid) || isAdmin();
        allow update, delete: if isAdmin();
      }

      match /subscription/{documentId} {
        allow read: if isOwner(uid) || isAdmin();
        allow update: if documentId == 'current' && isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['renewalReminderOptOut']);
        // Admin-only adjust path: lets support raise (or cap) an existing
        // subscriber's cloud Test Bank capacity mid-term. The owner can only
        // ever change the reminder flag; everything else stays admin/server
        // controlled.
        allow update: if documentId == 'current' && isAdmin();
        allow create, delete: if isAdmin();
      }

      match /myDay/{documentId} {
        allow read: if documentId == 'current' && (isOwner(uid) || isAdmin());
        // The shared My Day API compares item IDs, validates the legacy paid
        // entitlement equivalent of features.hasAny(['my-day']), and consumes
        // the daily-free counter in one transaction. Direct owner writes would bypass it.
        allow create, update, delete: if isAdmin();
      }

      match /myDayUsage/{documentId} {
        allow read: if documentId == 'current' && (isOwner(uid) || isAdmin());
        allow create, update, delete: if isAdmin();
      }

      match /courseProgress/{productId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.productId == productId
          && !request.resource.data.keys().hasAny(['role', 'status', 'purchasedProductIds', 'purchasedProductUpdateIds', 'coinBalance', 'eduCoins']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /session/{sessionId} {
        allow read: if sessionId == 'current' && isOwner(uid);
        allow create, update: if sessionId == 'current'
          && isOwner(uid)
          && request.resource.data.uid == uid
          && !request.resource.data.keys().hasAny(['role', 'status', 'purchasedProductIds']);
        allow delete: if sessionId == 'current' && isOwner(uid);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid) || isAdmin();
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow create, delete: if isAdmin();
      }

      // Per-student Google Drive personal copies. One doc per master file
      // id, carrying the student's own copyFileId. The copy itself lives in
      // the STUDENT's Drive; this is only the id mapping so the same copy
      // reopens on every device.
      match /driveCopies/{sourceFileId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.sourceFileId == sourceFileId
          && request.resource.data.copyFileId is string
          && request.resource.data.copyFileId.size() > 8
          && request.resource.data.copyFileId.size() <= 200;
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /webPushSubscriptions/{subscriptionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.endpoint is string
          && request.resource.data.endpoint.size() > 8
          && request.resource.data.endpoint.size() <= 2000
          && request.resource.data.p256dh is string
          && request.resource.data.p256dh.size() > 8
          && request.resource.data.p256dh.size() <= 500
          && request.resource.data.auth is string
          && request.resource.data.auth.size() > 4
          && request.resource.data.auth.size() <= 200
          && !request.resource.data.keys().hasAny(['email', 'phone', 'apiKey', 'authorization', 'secret', 'rawHtml']);
        allow delete: if isOwner(uid) || isAdmin();
      }


      // Cloud Revision Test Bank. Test documents and capacity counters are
      // server-authoritative (Admin SDK only) so a client cannot bypass its
      // plan limit. Owner-scoped progress documents may be updated directly so
      // Firestore's offline queue can preserve every answer while taking a test.
      match /revisionTests/{testId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /revisionUsage/{documentId} {
        allow read: if documentId == 'current' && (isOwner(uid) || isAdmin());
        allow create, update, delete: if isAdmin();
      }

      // Server-only deletion tombstones prevent another offline device from
      // re-importing a test that the learner permanently deleted.
      match /revisionDeletedTests/{testId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /revisionAttempts/{attemptId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.testId is number
          && request.resource.data.testKey is string
          && request.resource.data.testKey.size() > 0
          && request.resource.data.testKey.size() <= 40
          && !exists(/databases/$(database)/documents/users/$(uid)/revisionDeletedTests/$(request.resource.data.testKey))
          && request.resource.data.attempt is map
          && request.resource.data.answers is list
          && request.resource.data.answers.size() <= 100
          && !request.resource.data.keys().hasAny(['apiKey', 'authorization', 'secret', 'role']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /revisionItems/{itemId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.testId is number
          && request.resource.data.testKey is string
          && request.resource.data.testKey.size() > 0
          && request.resource.data.testKey.size() <= 40
          && !exists(/databases/$(database)/documents/users/$(uid)/revisionDeletedTests/$(request.resource.data.testKey))
          && request.resource.data.item is map
          && !request.resource.data.keys().hasAny(['apiKey', 'authorization', 'secret', 'role']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /revisionSessions/{sessionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && request.resource.data.uid == uid
          && request.resource.data.testKey is string
          && request.resource.data.testKey.size() > 0
          && request.resource.data.testKey.size() <= 40
          && !exists(/databases/$(database)/documents/users/$(uid)/revisionDeletedTests/$(request.resource.data.testKey))
          && (!('parentTestKeys' in request.resource.data)
            || (request.resource.data.parentTestKeys is list
              && request.resource.data.parentTestKeys.size() > 0
              && request.resource.data.parentTestKeys.size() <= 40
              && request.resource.data.parentTestKeys.all(k =>
                k is string
                && k.size() > 0
                && k.size() <= 40
                && !exists(/databases/$(database)/documents/users/$(uid)/revisionDeletedTests/$(k))
              )))
          && request.resource.data.session is map
          && request.resource.data.answers is list
          && request.resource.data.answers.size() <= 100
          && !request.resource.data.keys().hasAny(['apiKey', 'authorization', 'secret', 'role']);
        allow delete: if isOwner(uid) || isAdmin();
      }

      match /aiUsage/{documentId} {
        // Usage, in-flight reservations, plan snapshots and token-cost totals
        // are written only by the transactional Admin SDK generation API.
        // The Admin SDK bypasses Firestore rules; no browser client (including
        // an admin session) may mint, refund or otherwise manipulate quota.
        allow read: if documentId == 'current' && (isOwner(uid) || isAdmin());
        allow create, update, delete: if false;
      }

      match /aiMentorChats/{chatId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid)
          && request.resource.data.ownerId == uid
          && request.resource.data.userId == uid
          && request.resource.data.source == 'course_player_ai_mentor'
          && request.resource.data.expiresAt is string
          && request.resource.data.expiresAtMs is number
          && request.resource.data.expiresAtMs > request.time.toMillis()
          && request.resource.data.messageCount is number
          && request.resource.data.messageCount <= 100
          && !request.resource.data.keys().hasAny(['apiKey', 'authorization', 'secret', 'rawApiKey']);
        allow update: if isOwner(uid)
          && resource.data.ownerId == uid
          && request.resource.data.ownerId == uid
          && request.resource.data.userId == uid
          && request.resource.data.source == 'course_player_ai_mentor'
          && request.resource.data.expiresAt is string
          && request.resource.data.expiresAtMs is number
          && request.resource.data.expiresAtMs > request.time.toMillis()
          && request.resource.data.messageCount is number
          && request.resource.data.messageCount <= 100
          && !request.resource.data.keys().hasAny(['apiKey', 'authorization', 'secret', 'rawApiKey']);
        allow delete: if isOwner(uid) || isAdmin() || resource.data.expiresAtMs <= request.time.toMillis();
      }
    }

    match /siteProducts/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public surfaces may read published reviews only. Signed-in learners can
    // publish a review for themselves (it becomes visible immediately and is
    // counted in the live rating aggregate); only an admin can edit or delete
    // a review. Home/PDP order the published result by the latest createdAt
    // value on the client, so no composite index is needed.
    match /siteReviews/{reviewId} {
      allow read: if resource.data.status == 'published'
        || (signedIn() && (
          resource.data.customerId == request.auth.uid
          || resource.data.userId == request.auth.uid
          || resource.data.uid == request.auth.uid
        ));
      allow create: if signedIn()
        && request.resource.data.status in ['pending', 'published']
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.verifiedPurchase is bool
        && (request.resource.data.customerId == request.auth.uid
          || request.resource.data.userId == request.auth.uid
          || request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /siteOrders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }


    match /community_feed/{postId} {
      allow read: if signedIn();
      allow create: if (signedIn()
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.postType in ['text', 'image', 'poll'])
        || (isAdmin() && request.resource.data.source == 'admin');
      allow update: if signedIn();
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);

      match /replies/{replyId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.status in ['active', 'sent']
          && !request.resource.data.keys().hasAny(['email', 'phone', 'apiKey', 'authorization', 'secret', 'rawHtml']);
        allow update: if isAdmin()
          || (signedIn()
            && resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.senderId == resource.data.senderId
            && !request.resource.data.keys().hasAny(['email', 'phone', 'apiKey', 'authorization', 'secret', 'rawHtml']));
        allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
      }
    }

    match /community_status/{statusId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.type in ['text', 'image', 'poll'];
      allow update: if signedIn();
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /community_upload_quotas/{quotaId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create, update: if signedIn()
        && quotaId in [request.auth.uid + '_creator', request.auth.uid + '_status']
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.kind in ['creator', 'status']
        && request.resource.data.keys().hasOnly(['userId', 'kind', 'usedTypes', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /community_storage_meta/{metaId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && metaId == 'usage'
        && request.resource.data.keys().hasOnly(['usedBytes', 'limitBytes', 'bucketBytes', 'updatedAt'])
        && request.resource.data.usedBytes is number
        && request.resource.data.usedBytes >= 0;
      allow delete: if isAdmin();
    }

    match /community_profiles/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && communityVerificationAllowedOnCreate()
        && request.resource.data.keys().hasOnly([
          'uid', 'id', 'userId', 'ownerId', 'username', 'displayName', 'name', 'photoURL', 'avatar', 'role', 'bio',
          'subjects', 'masterTags', 'creatorCategory', 'searchableText', 'searchTokens',
          'followers', 'followerCount', 'followingCount', 'postCount', 'mutual',
          'verified', 'isVerified', 'isCreator', 'isPublic', 'isSuspended', 'source', 'isOnline', 'lastActiveAt', 'lastFollowedAt', 'lastFollowerAt', 'createdAt', 'updatedAt'
        ]);
      allow update: if isOwner(uid)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && communityVerificationUnchangedOnUpdate()
        && request.resource.data.keys().hasOnly([
          'uid', 'id', 'userId', 'ownerId', 'username', 'displayName', 'name', 'photoURL', 'avatar', 'role', 'bio',
          'subjects', 'masterTags', 'creatorCategory', 'searchableText', 'searchTokens',
          'followers', 'followerCount', 'followingCount', 'postCount', 'mutual',
          'verified', 'isVerified', 'isCreator', 'isPublic', 'isSuspended', 'source', 'isOnline', 'lastActiveAt', 'lastFollowedAt', 'lastFollowerAt', 'createdAt', 'updatedAt'
        ]);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['followerCount', 'followingCount', 'updatedAt', 'lastFollowedAt', 'lastFollowerAt'])
        && (!request.resource.data.diff(resource.data).changedKeys().hasAny(['followerCount']) || request.resource.data.followerCount in [resource.data.followerCount + 1, resource.data.followerCount - 1])
        && (!request.resource.data.diff(resource.data).changedKeys().hasAny(['followingCount']) || request.resource.data.followingCount in [resource.data.followingCount + 1, resource.data.followingCount - 1])
        && (!('followerCount' in request.resource.data) || request.resource.data.followerCount >= 0)
        && (!('followingCount' in request.resource.data) || request.resource.data.followingCount >= 0);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn() && resource.data.isPublic != false && resource.data.isSuspended != true && resource.data.hidden != true && resource.data.blocked != true;
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && communityVerificationAllowedOnCreate()
        && request.resource.data.keys().hasOnly([
          'uid', 'id', 'userId', 'ownerId', 'username', 'displayName', 'name', 'photoURL', 'avatar', 'role', 'bio',
          'subjects', 'masterTags', 'creatorCategory', 'searchableText', 'searchTokens',
          'followerCount', 'followingCount', 'postCount', 'isCreator', 'isVerified', 'verified', 'isPublic', 'isSuspended',
          'isOnline', 'lastActiveAt', 'lastFollowedAt', 'lastFollowerAt', 'createdAt', 'updatedAt'
        ]);
      allow update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && communityVerificationUnchangedOnUpdate()
        && request.resource.data.keys().hasOnly([
          'uid', 'id', 'userId', 'ownerId', 'username', 'displayName', 'name', 'photoURL', 'avatar', 'role', 'bio',
          'subjects', 'masterTags', 'creatorCategory', 'searchableText', 'searchTokens',
          'followerCount', 'followingCount', 'postCount', 'isCreator', 'isVerified', 'verified', 'isPublic', 'isSuspended',
          'isOnline', 'lastActiveAt', 'lastFollowedAt', 'lastFollowerAt', 'createdAt', 'updatedAt'
        ]);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['followerCount', 'followingCount', 'updatedAt', 'lastFollowedAt', 'lastFollowerAt'])
        && (!request.resource.data.diff(resource.data).changedKeys().hasAny(['followerCount']) || request.resource.data.followerCount in [resource.data.followerCount + 1, resource.data.followerCount - 1])
        && (!request.resource.data.diff(resource.data).changedKeys().hasAny(['followingCount']) || request.resource.data.followingCount in [resource.data.followingCount + 1, resource.data.followingCount - 1])
        && (!('followerCount' in request.resource.data) || request.resource.data.followerCount >= 0)
        && (!('followingCount' in request.resource.data) || request.resource.data.followingCount >= 0);
      allow delete: if isOwner(uid) || isAdmin();
    }

    match /community_follows/{followId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.followerId == request.auth.uid
        && request.resource.data.followingId is string
        && request.resource.data.followingId != request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.followingId
        && request.resource.data.status == 'active';

      allow update: if signedIn()
        && resource.data.followerId == request.auth.uid
        && request.resource.data.followerId == resource.data.followerId
        && request.resource.data.followingId == resource.data.followingId
        && request.resource.data.status in ['active', 'removed'];

      allow delete: if isAdmin()
        || (signedIn() && resource.data.followerId == request.auth.uid);
    }


    match /community_notifications/{notificationId} {
      allow read: if signedIn()
        && (isAdmin()
          || resource.data.recipientId == request.auth.uid
          || resource.data.actorId == request.auth.uid);

      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != ''
        && request.resource.data.type in ['reply', 'masterTag', 'status', 'creator', 'follow', 'share']
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.createdAt is number
        && !request.resource.data.keys().hasAny(['email', 'phone', 'apiKey', 'authorization', 'secret', 'rawHtml']);

      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['read', 'readAt', 'updatedAt']);

      allow delete: if isAdmin()
        || (signedIn() && resource.data.recipientId == request.auth.uid);
    }

    match /private_chats/{chatId} {
      function isShareParticipant() {
        return signedIn()
          && resource.data.participantMap[request.auth.uid] == true;
      }

      function isIncomingShareParticipant() {
        return signedIn()
          && request.resource.data.participantMap[request.auth.uid] == true
          && request.auth.uid in request.resource.data.participants;
      }

      allow read: if isShareParticipant();

      allow create: if isIncomingShareParticipant()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participantMap is map
        && request.resource.data.participantMap.keys().hasOnly(request.resource.data.participants)
        && request.resource.data.participantMap[request.resource.data.participants[0]] == true
        && request.resource.data.participantMap[request.resource.data.participants[1]] == true
        && request.resource.data.participantNames is map
        && request.resource.data.participantAvatars is map
        && request.resource.data.unreadCounts is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastMessageType == 'shared_item'
        && (!request.resource.data.keys().hasAny(['sharedItemCount'])
          || (request.resource.data.sharedItemCount is int
            && request.resource.data.sharedItemCount >= 0))
        && request.resource.data.keys().hasOnly([
          'participants', 'participantMap', 'participantNames', 'participantAvatars',
          'createdAt', 'updatedAt', 'lastMessage', 'lastMessageType',
          'lastMessageAt', 'lastSenderId', 'unreadCounts', 'sharedItemCount', 'pinnedMessageId'
        ]);

      allow update: if isShareParticipant()
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.participantMap == resource.data.participantMap
        && request.resource.data.createdAt == resource.data.createdAt
        && (!request.resource.data.keys().hasAny(['sharedItemCount'])
          || (request.resource.data.sharedItemCount is int
            && request.resource.data.sharedItemCount >= 0))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participantNames', 'participantAvatars', 'updatedAt', 'lastMessage',
          'lastMessageType', 'lastMessageAt', 'lastSenderId', 'unreadCounts',
          'sharedItemCount', 'pinnedMessageId'
        ]);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function parentChat() {
          return get(/databases/$(database)/documents/private_chats/$(chatId));
        }

        function isMessageParticipant() {
          return signedIn()
            && parentChat().data.participantMap[request.auth.uid] == true;
        }

        allow read: if isMessageParticipant();

        allow create: if isMessageParticipant()
          && request.resource.data.id == messageId
          && request.resource.data.conversationId == chatId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId is string
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.receiverId in parentChat().data.participants
          && request.resource.data.senderName is string
          && request.resource.data.receiverName is string
          && request.resource.data.type == 'shared_item'
          && request.resource.data.sharedItem is map
          && request.resource.data.sharedItem.sourceType in ['status', 'feed_message']
          && request.resource.data.sharedItem.sourceCollection in ['community_status', 'community_feed']
          && request.resource.data.sharedItem.sourceId is string
          && request.resource.data.sharedItem.title is string
          && request.resource.data.sharedItem.previewText is string
          && request.resource.data.sharedItem.keys().hasOnly([
            'sourceType', 'sourceId', 'sourceCollection', 'sourceOwnerId',
            'title', 'previewText', 'imageUrl', 'imageLayout', 'storagePath',
            'originalCreatedAt', 'originalExpiresAt', 'postType', 'pollOptions',
            'pollVotes', 'mediaType', 'mediaUrl'
          ])
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdAt == request.time
          && request.resource.data.readBy is map
          && request.resource.data.readBy[request.auth.uid] == true
          && request.resource.data.status == 'sent'
          && request.resource.data.keys().hasOnly([
            'id', 'conversationId', 'senderId', 'receiverId', 'senderName',
            'receiverName', 'type', 'sharedItem', 'createdAt', 'readBy', 'status'
          ]);

        allow update: if false;

        allow delete: if isAdmin()
          || (signedIn()
            && resource.data.senderId == request.auth.uid
            && resource.data.type == 'shared_item'
            && resource.data.createdAt is timestamp
            && request.time <= resource.data.createdAt + duration.value(30, 'm'));
      }
    }

    match /community_master_tags/{tagId} {
      allow read: if !('visibility' in resource.data) || resource.data.visibility == 'public' || (signedIn() && resource.data.ownerId == request.auth.uid) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.visibility in ['public', 'followers', 'private']
        && request.resource.data.status == 'active'
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 20
        && request.resource.data.message.size() <= 500
        && request.resource.data.category is string
        && request.resource.data.normalizedSearchText is string
        && !('authorEmail' in request.resource.data)
        && !('targetMasterEmail' in request.resource.data)
        && !('phone' in request.resource.data);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.authorId == resource.data.authorId)
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedByUsers', 'reactions', 'reactionUsers', 'updatedAt']));
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    match /siteSupportTickets/{ticketId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.customerUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }


    match /wallets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    match /coinTransactions/{transactionId} {
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/coinTransactions/$(transactionId))
          || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /productUnlocks/{unlockId} {
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/productUnlocks/$(unlockId))
          || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /youtubeWatchRewards/{rewardId} {
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/youtubeWatchRewards/$(rewardId))
          || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /watchProgress/{progressId} {
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/watchProgress/$(progressId))
          || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /pdfDownloadRewards/{rewardId} {
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/pdfDownloadRewards/$(rewardId))
          || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
