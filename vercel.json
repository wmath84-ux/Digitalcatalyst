{
  "crons": [
    {
      "path": "/api/cron/subscription-renewals",
      "schedule": "30 0 * * *"
    }
  ],
  "functions": {
    "api/referral-leaderboard.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/manifest",
      "destination": "/api/referral-leaderboard"
    },
    {
      "source": "/api/brand-icon",
      "destination": "/api/referral-leaderboard"
    },
    {
      "source": "/api/embed-proxy",
      "destination": "/api/referral-leaderboard"
    },
    {
      "source": "/api/revision/generate",
      "destination": "/api/referral-leaderboard"
    },
    {
      "source": "/api/revision/data",
      "destination": "/api/referral-leaderboard"
    },
    {
      "source": "/api/myday",
      "destination": "/api/referral-leaderboard"
    },
    {
      "source": "/api/push/fcm-register",
      "destination": "/api/push/send"
    },
    {
      "source": "/api/flowpath/control",
      "destination": "/api/referral-leaderboard"
    },
    {
      "source": "/api/subscription-gate",
      "destination": "/api/referral-leaderboard"
    }
  ]
}