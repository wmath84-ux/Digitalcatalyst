# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local environment variables (never commit)
.env

# Vercel CLI artifacts
.vercel/

# Android / Capacitor
# Local keystore + signing material — never commit. The release
# keystore is generated with `keytool -genkey -v -keystore
# android/app/eduvora.keystore -alias eduvora -keyalg RSA` and
# referenced by env vars (EDUVORA_KEYSTORE_FILE etc.) so the
# signing material itself stays out of Git.
android/app/*.keystore
android/app/*.jks
android/keystore.properties
android/app/google-services.json

# Build artifacts
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
android/.idea/
android/*.iml
android/app/*.iml
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json

# Scratch / temporary demo harnesses and upstream downloads (never shipped)
scratch/
.cache/
_shader_probe.mjs

# Temporary build bundles generated by runtime tests
build

# Joplin workspace scratch checkout.
# The built sub-application in public/my-day-workspace/ is shipped so
# deployments (e.g. Firebase Hosting) have the runtime ready without requiring
# upstream git monorepo rebuilds in CI.
.joplin-src/
