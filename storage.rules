rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    function isPrivateChatParticipant(chatId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/private_chats/$(chatId))
        && firestore.get(/databases/(default)/documents/private_chats/$(chatId)).data.participantMap[request.auth.uid] == true;
    }

    match /adminProductContent/audio/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    match /adminProductContent/video/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 75 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    match /adminProductContent/pdf/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    match /adminProductContent/ebook/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024;
    }

    match /adminProductContent/sheet/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /adminProductImages/{productId}/{slot}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /privateChats/{chatId}/{messageId}/{fileName} {
      allow read: if isPrivateChatParticipant(chatId);
      allow write: if isPrivateChatParticipant(chatId)
        && fileName == 'message.json'
        && request.resource.size < 128 * 1024;
      allow delete: if isPrivateChatParticipant(chatId);
    }

    match /community/{allPaths=**} {
      allow read, write: if signedIn();
    }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
