rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'wmath84@gmail.com'
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isPrivateChatParticipant(chatId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/private_chats/$(chatId))
        && firestore.get(/databases/(default)/documents/private_chats/$(chatId)).data.participantMap[request.auth.uid] == true;
    }

    match /adminProductContent/audio/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    match /adminProductContent/video/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 75 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    match /adminProductContent/pdf/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // First-class Course Player Read uploads. The client rejects 100 MiB and
    // larger files too, so the finite limit and content type agree end to end.
    match /adminProductContent/read/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && fileName.matches('^[A-Za-z0-9._-]+[.]pdf$')
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }

    match /adminProductContent/ebook/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 25 * 1024 * 1024;
    }

    match /adminProductContent/sheet/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /adminProductImages/{productId}/{slot}/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /privateChats/{chatId}/{messageId}/{fileName} {
      allow read: if isPrivateChatParticipant(chatId);
      allow write: if isPrivateChatParticipant(chatId)
        && fileName == 'message.json'
        && request.resource.size < 128 * 1024;
      allow delete: if isPrivateChatParticipant(chatId);
    }

    // Profile photos are public avatar assets; only their owner can upload,
    // and uploads are restricted to small, browser-safe raster images.
    match /userProfilePhotos/{uid}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /community/{allPaths=**} {
      allow read, write: if signedIn();
    }

    // Course Player → Read library: the LEARNER's own PDFs
    // (`userReadUploads/{uid}/{uploadId}-{slug}.pdf`). Ownership is the PATH:
    // only the folder's own uid may write there, the bytes must really be a
    // PDF, and the same 100 MiB ceiling the viewer / Firestore document use
    // applies — READ_PDF_MAX_BYTES in utils/readResources.js and
    // READ_UPLOAD_MAX_BYTES in utils/readUploads.js. Reads are the owner's
    // (the viewer fetches the download URL) plus admins.
    match /userReadUploads/{uid}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && fileName.matches('^[A-Za-z0-9._-]+[.]pdf$')
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Joplin My Day workspace attachments:
    //   myDayWorkspace/{uid}/resources/{resourceId}/{safeName}
    // The metadata row (`users/{uid}/joplinResources/{resourceId}`) is written
    // by the server path first, so bytes can only ever land for a row that
    // exists and belongs to the caller. The 25 MB ceiling and the MIME list
    // mirror `MAX_RESOURCE_BYTES` / `ALLOWED_RESOURCE_MIME` in
    // `src/joplin/joplinStorageBridge.ts` — the client refuses them too, so the
    // rule and the UI agree end to end.
    match /myDayWorkspace/{uid}/resources/{resourceId}/{fileName} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource != null
        && request.resource.size > 0
        && request.resource.size < 25 * 1024 * 1024
        && (request.resource.contentType.matches('image/(png|jpeg|webp|gif|svg[+]xml)')
          || request.resource.contentType.matches('audio/(mpeg|mp4|webm|wav)')
          || request.resource.contentType.matches('video/mp4')
          || request.resource.contentType in ['application/pdf', 'application/zip', 'application/json', 'text/plain', 'text/markdown', 'text/csv']);
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
