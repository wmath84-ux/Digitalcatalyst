VITE_REVIEW_STABLE_MODE=true

# ---- API origin fallbacks (see src/utils/apiBase.ts) ------------------------
# The client tries, in order: the page's own origin, VITE_API_ORIGIN, then
# VITE_VERCEL_API_ORIGIN. Leave both EMPTY for the defaults
# (https://eduvora.shop and https://digitalcatalyst.vercel.app).
#
# You MUST set VITE_VERCEL_API_ORIGIN if the Vercel project lives inside a
# TEAM: such a project never gets the plain `digitalcatalyst.vercel.app` name —
# its generated domains carry the team slug (for example
# `digitalcatalyst-git-main-<team>-projects.vercel.app`). Copy the project's
# real Production alias from Vercel → Project → Settings → Domains.
VITE_API_ORIGIN=
VITE_VERCEL_API_ORIGIN=
# Same idea for `node scripts/api-health-check.mjs` (comma-separated).
API_HEALTH_ORIGINS=

# Firebase Authentication uses the web app configuration in firebase.ts.
# Enable Email/Password and Google in Firebase Console and authorize each deployed domain.
#
# OPTIONAL — only for making the Google *redirect* fallback first-party
# (Firebase's redirect-best-practices Option 3). Leave it EMPTY unless you have
# also added https://<your-domain>/__/auth/handler to the Google OAuth web
# client's authorized redirect URIs; the app signs in with a popup by default
# and needs no value here. See docs/google-signin-web.md.
VITE_FIREBASE_AUTH_DOMAIN=
# Cloudinary unsigned image uploads. Create an unsigned upload preset in Cloudinary first.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_IMAGE_FOLDER=website-images

# Razorpay live payment
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Web Push (VAPID) notifications
# VITE_WEB_PUSH_VAPID_PUBLIC_KEY is injected into the client for pushManager.subscribe().
# Generate a key pair once:  npx web-push generate-vapid-keys --json
VITE_WEB_PUSH_VAPID_PUBLIC_KEY=BL35cvR9aNQmqzemYR1Zq8ZEfhRUDH1bgNKZ4W8K9n8iqSuU5046MRYDouaAmjkptDEyvEbBwJdr3VBM7dyybk8
# Server-side only (Vercel env). Do not expose the private key to the client.
WEB_PUSH_VAPID_PUBLIC_KEY=BL35cvR9aNQmqzemYR1Zq8ZEfhRUDH1bgNKZ4W8K9n8iqSuU5046MRYDouaAmjkptDEyvEbBwJdr3VBM7dyybk8
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@eduvora.app

# AI question generation (Daily Test & Revision — admin panel + student app).
# Runs fully client-side (no serverless function — the project stays within
# Vercel's 12-function Hobby plan limit). Admins and students can connect any
# AI provider — Google Gemini, OpenAI, Anthropic Claude, OpenRouter, Groq or
# any OpenAI-compatible custom API. Keys are stored only in the visitor's own
# browser (localStorage) and sent directly to the chosen provider — never in
# the public bundle. The admin can publish a default provider + model (and
# optionally a shared key) for all users from the admin panel
# (Revision & Daily Tests → AI Generate). A built-in offline generator is
# used automatically when no key is set.
# Server-side Firebase Admin credential. Required by secure price quotes,
# Razorpay order creation, payment verification/entitlement delivery, and
# stored web-push targeting. Use ONE of these deployment formats:
#   1) complete service-account JSON (plain JSON or base64-encoded JSON), or
#   2) the three individual FIREBASE_* variables below.
FIREBASE_SERVICE_ACCOUNT=
# Secret sent by Vercel Cron as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
# FIREBASE_PROJECT_ID=my-website-761e9
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
